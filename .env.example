# Variáveis do frontend. Ficam EXPOSTAS no navegador: nunca coloque segredos aqui.
# A service_role do Supabase pertence só ao la-dolce-api e nunca entra neste repositório.

# Supabase > Project Settings > API (local: npm run db:status no la-dolce-api)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# URL pública do site (links canônicos, sitemap e redefinição de senha)
VITE_SITE_URL=https://seu-dominio.com.br

# Contato do suporte técnico, exibido em "Ajuda" no painel (opcional)
VITE_SUPPORT_NAME=
# WhatsApp com 55 + DDD, só números. Ex.: 5511999999999
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
